// StockWallet — Prisma schema
// Datasource: Neon Postgres (pooled URL for app runtime, direct URL for migrations)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─────────────────────────────────────────────
// Single-user auth: username + password + TOTP (authenticator app) 2FA
// ─────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  accounts     Account[]
  watchlist    WatchlistItem[]
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  symbol    String // uppercase ticker
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

// ─────────────────────────────────────────────
// Portfolio: brokerage account + transaction ledger
// Positions are derived from transactions (never stored).
// ─────────────────────────────────────────────

model Account {
  id           String        @id @default(cuid())
  userId       String
  name         String // e.g. "Robinhood"
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

enum TradeSide {
  BUY
  SELL
}

model Transaction {
  id        String    @id @default(cuid())
  accountId String
  symbol    String // uppercase ticker, e.g. "AAPL"
  side      TradeSide
  quantity  Decimal   @db.Decimal(28, 10) // fractional shares / crypto amounts
  price     Decimal   @db.Decimal(20, 8) // per-unit price (crypto needs >4 decimals)
  fees      Decimal   @default(0) @db.Decimal(20, 8)
  tradedAt  DateTime
  note      String?
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, symbol])
  @@index([accountId, tradedAt])
}
