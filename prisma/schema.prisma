// StockWallet — Prisma schema
// Datasource: Neon Postgres (pooled URL for app runtime, direct URL for migrations)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// ─────────────────────────────────────────────
// Single-user auth: username + password + TOTP (authenticator app) 2FA
// ─────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String
  totpSecret   String?
  totpEnabled  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  accounts     Account[]
  watchlist    WatchlistItem[]
  journal      JournalEntry[]
  alerts       Alert[]
  dividends    Dividend[]
}

enum AlertDirection {
  ABOVE
  BELOW
}

model Alert {
  id              String         @id @default(cuid())
  userId          String
  symbol          String
  direction       AlertDirection
  targetPrice     Decimal        @db.Decimal(20, 8)
  active          Boolean        @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime       @default(now())
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  symbol    String // uppercase ticker
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, symbol])
}

// ─────────────────────────────────────────────
// Dividends: cash income received from a holding. Kept OUT of the transaction
// ledger on purpose — a dividend doesn't change shares or cost basis, it's
// realized income that feeds TOTAL RETURN (price gains + income). Storing it
// as a fake trade would corrupt the tested cost-basis engine.
// ─────────────────────────────────────────────

model Dividend {
  id        String   @id @default(cuid())
  userId    String
  symbol    String // uppercase ticker
  amount    Decimal  @db.Decimal(20, 8) // total cash received (not per-share)
  paidAt    DateTime
  note      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, symbol])
  @@index([userId, paidAt])
}

// ─────────────────────────────────────────────
// Portfolio: brokerage account + transaction ledger
// Positions are derived from transactions (never stored).
// ─────────────────────────────────────────────

model Account {
  id           String        @id @default(cuid())
  userId       String
  name         String // e.g. "Robinhood"
  createdAt    DateTime      @default(now())
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

enum TradeSide {
  BUY
  SELL
}

model Transaction {
  id        String    @id @default(cuid())
  accountId String
  symbol    String // uppercase ticker, e.g. "AAPL"
  side      TradeSide
  quantity  Decimal   @db.Decimal(28, 10) // fractional shares / crypto amounts
  price     Decimal   @db.Decimal(20, 8) // per-unit price (crypto needs >4 decimals)
  fees      Decimal   @default(0) @db.Decimal(20, 8)
  tradedAt  DateTime
  note      String?
  createdAt DateTime  @default(now())
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, symbol])
  @@index([accountId, tradedAt])
}

// ─────────────────────────────────────────────
// Bet Journal: log a thesis, track it, grade it.
// ─────────────────────────────────────────────

enum Conviction {
  LOW
  MEDIUM
  HIGH
}

enum ThesisDirection {
  BULL
  BEAR
}

enum ThesisStatus {
  OPEN
  CLOSED
}

enum Verdict {
  RIGHT
  WRONG
}

model JournalEntry {
  id          String          @id @default(cuid())
  userId      String
  symbol      String
  thesis      String
  direction   ThesisDirection @default(BULL)
  entryPrice  Decimal?        @db.Decimal(20, 8) // price snapshot when logged
  targetPrice Decimal?        @db.Decimal(20, 8)
  timeframe   DateTime? // optional "by when"
  conviction  Conviction      @default(MEDIUM)
  status      ThesisStatus    @default(OPEN)
  verdict     Verdict? // set when graded (also closes it)
  createdAt   DateTime        @default(now())
  resolvedAt  DateTime?
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
